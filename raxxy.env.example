# raxxy.env.example
#
# Copy this file to raxxy.env and replace the placeholder values with your
# actual credentials.  raxxy.env is listed in .gitignore and must NEVER be
# committed to version control.
#
# Usage:
#   cp raxxy.env.example raxxy.env
#   # Edit raxxy.env with your real keys
#

# ---------------------------------------------------------------------------
# Weather / external API
# ---------------------------------------------------------------------------
# Groq API key used by the AI Mechanic chat feature.
# Obtain a key from https://console.groq.com and paste it here.
API_KEY=your_groq_api_key_here

# OpenWeather API key used to fetch weather data for the driver dashboard.
# Obtain a key from https://openweathermap.org/api and paste it here.
WEATHER_API_KEY=your_weather_api_key_here
